# Search gateway: ONE port serves MCP (/mcp), settings (/config, /test), and /health
SEARCH_HOST=127.0.0.1
SEARCH_PORT=8787

# Optional SearXNG backend. If set, it is tried before DuckDuckGo.
# SEARXNG_URL=http://127.0.0.1:8080

# Search provider preference: searxng | duckduckgo | google | auto
SEARCH_PROVIDER=auto
SEARCH_MAX_RESULTS=8
SEARCH_TIMEOUT_MS=20000
SEARCH_CONFIG_PATH=./data/search-config.json

# Address of the search stack for DSH (one URL; can point at another host):
# DSH_SEARCH_URL=http://127.0.0.1:8787

# Optional Google Programmable Search (Custom Search JSON API, legacy)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Optional Google Gemini Search (whole-web grounding, AI Studio key, billing required)
GOOGLE_GEMINI_API_KEY=
# GOOGLE_GEMINI_MODEL=gemini-3.8-flash

# Optional Brave Search API (free tier, independent web index)
BRAVE_API_KEY=

# Search provider priority order (comma separated). First = searched first.
# SEARCH_PROVIDER_ORDER=searxng,google-gemini,brave,duckduckgo

# Optional Google Vertex AI Search (Agent Search, searchLite)
GOOGLE_VERTEX_API_KEY=
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_ENGINE_ID=
# GOOGLE_VERTEX_ENDPOINT=https://discoveryengine.googleapis.com/v1

# Browser service
BROWSER_HOST=127.0.0.1
BROWSER_PORT=8788
BROWSER_VIEWER_HOST=127.0.0.1
BROWSER_VIEWER_PORT=8791
# Leave blank to auto-discover Chrome/Chromium, or set an explicit path.
# CHROME_PATH=/usr/bin/chromium
BROWSER_HEADLESS=true
BROWSER_PROFILE_ROOT=./data/sessions
BROWSER_ARTIFACT_ROOT=./artifacts
# Close sessions idle for this long (ms); 0 disables the sweep.
BROWSER_IDLE_TIMEOUT_MS=1800000

# The DSH host plugin reads these to proxy /dsh-browser/* (defaults shown):
# DSH_BROWSER_API_URL=http://127.0.0.1:8790
# DSH_BROWSER_VIEWER_URL=http://127.0.0.1:8791
# DSH_SEARCH_URL=http://127.0.0.1:8787
