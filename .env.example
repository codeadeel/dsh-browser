# dsh-browser — stack host configuration
#
# The DSH gateway URL is NOT configured here. Set it once in the plugin UI:
#
#   Plugins -> dsh-browser-panel -> Stack gateway address -> Save
#     local:  http://127.0.0.1:8787
#     remote: https://search.codeadeel.com
#
# This avoids maintaining the same gateway host/port in two places.
#
# ── Gateway: the only published backend port ───────────────────────────────
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8787
#
# GATEWAY_BIND:
#   127.0.0.1   local DSH on this host
#   10.0.0.5    private/VPN address reachable by a remote DSH
#   0.0.0.0     all interfaces; only with a firewall/VPN
#
# With a reverse proxy or Cloudflare Tunnel on this host, keep 127.0.0.1.
# The tunnel/proxy targets http://127.0.0.1:8787; the public HTTPS URL goes
# in the plugin UI.

# ── Search service (internal; not published) ───────────────────────────────
SEARCH_HOST=127.0.0.1
SEARCH_PORT=8787
SEARCH_PROVIDER=auto
SEARCH_MAX_RESULTS=8
SEARCH_TIMEOUT_MS=20000
SEARCH_CONFIG_PATH=./data/search-config.json
# Optional SearXNG backend for host runs; compose uses http://searxng:8080.
# SEARXNG_URL=http://127.0.0.1:8080
# SEARCH_PROVIDER_ORDER=searxng,google-gemini,brave,duckduckgo

# Optional search provider keys. The plugin UI can also set these at runtime.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_GEMINI_API_KEY=
# GOOGLE_GEMINI_MODEL=gemini-3.8-flash
BRAVE_API_KEY=
GOOGLE_VERTEX_API_KEY=
GOOGLE_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_ENGINE_ID=
# GOOGLE_VERTEX_ENDPOINT=https://discoveryengine.googleapis.com/v1

# ── Browser service (internal; not published) ──────────────────────────────
BROWSER_HOST=127.0.0.1
BROWSER_PORT=8790
BROWSER_VIEWER_HOST=127.0.0.1
BROWSER_VIEWER_PORT=8791
# CHROME_PATH=/usr/bin/chromium   # host runs only; Docker includes Chrome
BROWSER_HEADLESS=true
BROWSER_PROFILE_ROOT=./data/sessions
BROWSER_ARTIFACT_ROOT=./artifacts
BROWSER_IDLE_TIMEOUT_MS=1800000
